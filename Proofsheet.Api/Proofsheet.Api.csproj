<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The ID keeps the project's original A.I.R.A name so existing local user secrets keep loading. -->
    <UserSecretsId>aira-api-4aa9bf97-9e79-4e64-93f3-9db6bb3e9f9d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Proofsheet.Application\Proofsheet.Application.csproj" />
    <ProjectReference Include="..\Proofsheet.Infrastructure\Proofsheet.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Prompts\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
